# Variáveis principais. Configure valores reais somente nos Secrets da hospedagem.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
SECURITY_OWNER_ID=
SECURITY_GUILD_ID=
SECURITY_ALERT_CHANNEL_ID=
GERAIS_LOG_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=
MODERATION_ROLE_IDS=
# PostgreSQL opcional; use a URL de conexão privada.
DATABASE_URL=
# OAuth2 opcional para confirmar e-mail; configure as quatro variáveis juntas.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
VERIFICATION_OAUTH_REDIRECT_URI=
VERIFICATION_STATE_SECRET=
# Chave aleatória exclusiva do bridge.
ROBLOX_BRIDGE_SECRET=
# Configuração de verificação.
VERIFICATION_MIN_ACCOUNT_DAYS=30
VERIFICATION_REQUIRE_SCREENING=true
VERIFICATION_REQUIRE_DISCORD_VERIFICATION=true

# Auditoria administrativa privada: opcionais; fallback para GERAIS_LOG_CHANNEL_ID e canal Shield.
DISCORD_AUDIT_LOG_CHANNEL_ID=
DISCORD_CHANNEL_LOG_CHANNEL_ID=
DISCORD_ROLE_LOG_CHANNEL_ID=
DISCORD_MEMBER_LOG_CHANNEL_ID=
DISCORD_SERVER_LOG_CHANNEL_ID=
